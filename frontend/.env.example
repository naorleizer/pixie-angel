# =============================================================================
# PIXIE FRONTEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# API URL for backend server
# For local development with backend on port 35000:
VITE_API_URL=http://localhost:35000

# For Docker (nginx proxies /api to backend, so leave empty or use relative):
# VITE_API_URL=
