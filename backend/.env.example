# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# LLM API Keys (LiteLLM supports multiple providers)
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google / Gemini (if you want to use Gemini Flash or other Google models)
# Set provider to 'gemini' in LLM_PROVIDER and add your Gemini API key
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI
# AZURE_API_KEY=your_azure_api_key_here
# AZURE_API_BASE=your_azure_endpoint
# AZURE_API_VERSION=2023-05-15

# Other providers supported by LiteLLM
# COHERE_API_KEY=your_cohere_key
# HUGGINGFACE_API_KEY=your_hf_key

# Server Configuration
PORT=5000
HOST=0.0.0.0
